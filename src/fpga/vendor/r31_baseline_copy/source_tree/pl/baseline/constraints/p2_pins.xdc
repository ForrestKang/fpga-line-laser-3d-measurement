# Candidate manual wiring from PYNQ-Z2 master XDC + local MT9V034 diagnostic.
# No EXPOSURE and no motor/laser outputs in P2.
set_property PACKAGE_PIN T14 [get_ports {cam_data[0]}]
set_property PACKAGE_PIN U12 [get_ports {cam_data[1]}]
set_property PACKAGE_PIN U13 [get_ports {cam_data[2]}]
set_property PACKAGE_PIN V13 [get_ports {cam_data[3]}]
set_property PACKAGE_PIN V15 [get_ports {cam_data[4]}]
set_property PACKAGE_PIN T15 [get_ports {cam_data[5]}]
set_property PACKAGE_PIN R16 [get_ports {cam_data[6]}]
set_property PACKAGE_PIN U17 [get_ports {cam_data[7]}]
set_property PACKAGE_PIN V17 [get_ports cam_lv]
set_property PACKAGE_PIN V18 [get_ports cam_fv]
set_property PACKAGE_PIN T16 [get_ports cam_reset_n]
set_property PACKAGE_PIN R17 [get_ports cam_standby]
set_property PACKAGE_PIN P16 [get_ports cam_sda]
set_property PACKAGE_PIN P15 [get_ports cam_scl]
set_property PACKAGE_PIN U18 [get_ports cam_pclk]
set_property IOSTANDARD LVCMOS33 [get_ports {cam_data[*] cam_lv cam_fv cam_reset_n cam_standby cam_sda cam_scl cam_pclk}]
set_property DRIVE 8 [get_ports {cam_reset_n cam_standby cam_scl cam_sda}]
set_property SLEW SLOW [get_ports {cam_reset_n cam_standby cam_scl cam_sda}]
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
