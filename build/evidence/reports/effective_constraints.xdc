####################################################################################
# Constraints from file : 'p2_pins.xdc'
####################################################################################

# Candidate manual wiring from PYNQ-Z2 master XDC + local MT9V034 diagnostic.
# No EXPOSURE and no motor/laser outputs in P2.
current_instance -quiet
set_property PACKAGE_PIN T14 [get_ports {cam_data[0]}]
set_property PACKAGE_PIN U12 [get_ports {cam_data[1]}]
set_property PACKAGE_PIN U13 [get_ports {cam_data[2]}]
set_property PACKAGE_PIN V13 [get_ports {cam_data[3]}]
set_property PACKAGE_PIN V15 [get_ports {cam_data[4]}]
set_property PACKAGE_PIN T15 [get_ports {cam_data[5]}]
set_property PACKAGE_PIN R16 [get_ports {cam_data[6]}]
set_property PACKAGE_PIN U17 [get_ports {cam_data[7]}]
set_property PACKAGE_PIN V17 [get_ports cam_lv]
set_property PACKAGE_PIN V18 [get_ports cam_fv]
set_property PACKAGE_PIN T16 [get_ports cam_reset_n]
set_property PACKAGE_PIN R17 [get_ports cam_standby]
set_property PACKAGE_PIN P16 [get_ports cam_sda]
set_property PACKAGE_PIN P15 [get_ports cam_scl]
set_property PACKAGE_PIN U18 [get_ports cam_pclk]
set_property IOSTANDARD LVCMOS33 [get_ports {{cam_data[*]} cam_lv cam_fv cam_reset_n cam_standby cam_sda cam_scl cam_pclk}]
set_property DRIVE 8 [get_ports cam_reset_n]
set_property DRIVE 8 [get_ports cam_standby]
set_property DRIVE 8 [get_ports cam_scl]
set_property DRIVE 8 [get_ports cam_sda]
set_property SLEW SLOW [get_ports cam_reset_n]
set_property SLEW SLOW [get_ports cam_standby]
set_property SLEW SLOW [get_ports cam_scl]
set_property SLEW SLOW [get_ports cam_sda]
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]


####################################################################################
# Constraints from file : 'p2_timing.xdc'
####################################################################################

# Sensor timing: local MT9V034 DS Rev.G Table18/page52, falling PCLK data edge.
# Document tPD [-3,3]ns; LV/FV [5,9]ns. Add +/-1ns manual-wire skew budget.
# Actual mode, clock and board delays must be verified at Gate A.
create_clock -period 41.667 -name cam_pclk [get_ports cam_pclk]
set_input_delay -clock cam_pclk -clock_fall -min -4.000 [get_ports {cam_data[*]}]
set_input_delay -clock cam_pclk -clock_fall -max 4.000 [get_ports {cam_data[*]}]
set_input_delay -clock cam_pclk -clock_fall -min 4.000 [get_ports {cam_fv cam_lv}]
set_input_delay -clock cam_pclk -clock_fall -max 10.000 [get_ports {cam_fv cam_lv}]
# Slow open-drain SCCB pins are independently synchronized at their input.
# Exact first-stage exceptions are installed post-synthesis, with path inventory.
# These are asynchronous/slow sensor control pins, not inputs sampled by
# FCLK0 at 100 MHz. MT9V034 Rev.G p60 specifies RESET_BAR >=750ns and a
# 10-SYSCLK wait before SCCB; Table19 specifies >=100ns data setup at 400kHz.
# Zero external clock-relative delay identifies the board boundary; the
# explicit 20ns propagation budget below bounds each control output path.
# This engineering budget does not relax internal 10ns SYS register paths.
set_max_delay -datapath_only -from [get_clocks -quiet -include_generated_clocks clk_fpga_0] -to [get_ports {cam_reset_n cam_standby cam_scl cam_sda}] 20.000


####################################################################################
# Constraints from file : 'p2_hdmi_out.xdc'
####################################################################################

# PYNQ-Z2 HDMI OUT pins, derived from the official PYNQ v3.1 Pynq-Z2 base XDC
# and cross-checked against D:\BoardDocumentation\PYNQ-Z2\Xilinx_PYNQ_base_reference.xdc.
# Source revision and individual file hashes are recorded under build/vendor/.
# The HPD net drives the board's HDMI detect buffer as in the official design.
set_property -dict {PACKAGE_PIN L17 IOSTANDARD TMDS_33} [get_ports hdmi_out_clk_n]
set_property -dict {PACKAGE_PIN L16 IOSTANDARD TMDS_33} [get_ports hdmi_out_clk_p]
set_property -dict {PACKAGE_PIN K18 IOSTANDARD TMDS_33} [get_ports {hdmi_out_data_n[0]}]
set_property -dict {PACKAGE_PIN K17 IOSTANDARD TMDS_33} [get_ports {hdmi_out_data_p[0]}]
set_property -dict {PACKAGE_PIN J19 IOSTANDARD TMDS_33} [get_ports {hdmi_out_data_n[1]}]
set_property -dict {PACKAGE_PIN K19 IOSTANDARD TMDS_33} [get_ports {hdmi_out_data_p[1]}]
set_property -dict {PACKAGE_PIN H18 IOSTANDARD TMDS_33} [get_ports {hdmi_out_data_n[2]}]
set_property -dict {PACKAGE_PIN J18 IOSTANDARD TMDS_33} [get_ports {hdmi_out_data_p[2]}]
set_property -dict {PACKAGE_PIN R19 IOSTANDARD LVCMOS33} [get_ports hdmi_out_hpd]


####################################################################################
# Constraints from file : 'b_motion_pins.xdc'
####################################################################################

# Stage-B direct-wire motor permit outputs for the structured-light candidate.
# The direct artifact maps motor_enable to active-low EN.  An expansion build
# may map the same package pin to enable_request; the carrier mode is a
# read-only build parameter and is not changed at runtime.
set_property PACKAGE_PIN W14 [get_ports motor_step]
set_property PACKAGE_PIN Y14 [get_ports motor_dir]
set_property PACKAGE_PIN T11 [get_ports motor_enable]
set_property PACKAGE_PIN T10 [get_ports motor_heartbeat]
set_property IOSTANDARD LVCMOS33 [get_ports motor_step]
set_property IOSTANDARD LVCMOS33 [get_ports motor_dir]
set_property IOSTANDARD LVCMOS33 [get_ports motor_enable]
set_property IOSTANDARD LVCMOS33 [get_ports motor_heartbeat]
set_property DRIVE 8 [get_ports motor_step]
set_property DRIVE 8 [get_ports motor_dir]
set_property DRIVE 8 [get_ports motor_enable]
set_property DRIVE 8 [get_ports motor_heartbeat]
set_property SLEW SLOW [get_ports motor_step]
set_property SLEW SLOW [get_ports motor_dir]
set_property SLEW SLOW [get_ports motor_enable]
set_property SLEW SLOW [get_ports motor_heartbeat]


####################################################################################
# Constraints from file : 'r42_buttons.xdc'
####################################################################################

# R42 buttons: verified against Xilinx/PYNQ official logictools XDC.
set_property -dict {PACKAGE_PIN D19 IOSTANDARD LVCMOS33} [get_ports {btn[0]}]
set_property -dict {PACKAGE_PIN D20 IOSTANDARD LVCMOS33} [get_ports {btn[1]}]
set_property -dict {PACKAGE_PIN L20 IOSTANDARD LVCMOS33} [get_ports {btn[2]}]
set_property -dict {PACKAGE_PIN L19 IOSTANDARD LVCMOS33} [get_ports {btn[3]}]


